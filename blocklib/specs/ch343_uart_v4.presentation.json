  "directWiringObligations": [
    {
      "nets": [
        "LED_A"
      ],
      "note": "the VBUS lamp's cathode and R3 are one conductor inside the usb_c island: labelPolicy.local is 'wire', so naming the lamp's return would be a label where the policy promises a wire (534; the pair is D1 pin 2 to R3 pin 1, nothing else on the net)"
    }
  ],
  "localLabelObligations": [
    {
      "nets": [
        "D+",
        "D-"
      ],
      "note": "Type-C 可逆引脚交错: the receptacle's data pins are mirrored pairs, D+ on USB1.A6/B6 and D- on USB1.A7/B7, so one wire inside usb_c would have to tie the two halves of a pair and draw a U-line that presents one pin as the other; instead each of the four pins takes its own short stub and the golden board's same-name label (D+ on A6 and B6, D- on A7 and B7), and the pair reaches U1.5/U1.6 by the same-named labels there — the name carries the net, no U-line does"
    }
  ],
